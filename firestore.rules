rules_version = '2';

// Reglas de seguridad de Firestore.
// Para esta versión, la app carga directamente con la configuración del proyecto,
// sin depender de Auth anónima.

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      allow read, write: if true;
    }

    match /productos/{sku} {
      allow read, write: if true;
    }

    match /ventas/{id} {
      allow read, write: if true;
    }

    match /vendedores/{id} {
      allow read, write: if true;
    }

    match /zonas/{id} {
      allow read, write: if true;
    }

    match /entregas/{id} {
      allow read, write: if true;
    }

    match /solicitudes/{id} {
      allow read, write: if true;
    }

    match /agendas/{id} {
      allow read, write: if true;
    }
  }
}
